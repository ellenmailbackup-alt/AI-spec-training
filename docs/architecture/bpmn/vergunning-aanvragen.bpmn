    <bpmn:sequenceFlow id="f13" sourceRef="T6" targetRef="G4" />
    <bpmn:sequenceFlow id="f14" sourceRef="G4" targetRef="T7" />
    <bpmn:sequenceFlow id="f15" sourceRef="T7" targetRef="G5" />
    <bpmn:sequenceFlow id="f16" name="Nee" sourceRef="G5" targetRef="T4" />
    <bpmn:sequenceFlow id="f17" name="Ja" sourceRef="G5" targetRef="T8" />
    <bpmn:sequenceFlow id="f18" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="f19" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="f20" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="f21" sourceRef="T11" targetRef="G6" />
    <bpmn:sequenceFlow id="f22" name="Ja" sourceRef="G6" targetRef="T12" />
    <bpmn:sequenceFlow id="f23" name="Nee" sourceRef="G6" targetRef="G7" />
    <bpmn:sequenceFlow id="f24" sourceRef="T12" targetRef="G7" />
    <bpmn:sequenceFlow id="f25" sourceRef="G7" targetRef="T13" />
    <bpmn:sequenceFlow id="f26" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="f27" sourceRef="T14" targetRef="EndOk" />
  </bpmn:process>
