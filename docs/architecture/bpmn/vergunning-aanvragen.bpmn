<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Vergunning" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:error id="Err_Dubbel" name="Vergunning bestaat al" errorCode="VERGUNNING_DUBBEL" />
  <bpmn:collaboration id="Collab_Vergunning">
    <bpmn:participant id="P_Kantoor" name="Vergunning aanvragen" processRef="Proc_Vergunning" />
    <bpmn:participant id="P_Extern" name="Extern aanvraagsysteem (geen integratie)" />
    <bpmn:messageFlow id="m1" name="Document" sourceRef="T11" targetRef="P_Extern" />
    <bpmn:messageFlow id="m2" name="Bevestiging (optioneel)" sourceRef="P_Extern" targetRef="T12" />
    <bpmn:textAnnotation id="a1"><bpmn:text>Dubbelregel is afhankelijk van het vergunningtype (per vestiging, per jaar, verlenging ...)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="a2"><bpmn:text>Vraag wordt gesteld per gewijzigde vooraf ingevulde waarde</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="a3"><bpmn:text>Elk gegenereerd document wordt aan het dossier toegevoegd; het laatste is zichtbaar in het vergunningsrecord</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="a4"><bpmn:text>Status is op elk moment vrij te kiezen: ontbrekende gegevens · klaar om te verwerken · aangevraagd. Beginstatus: ontbrekende gegevens. Elke statuswijziging wordt gelogd.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as_a1" sourceRef="G1" targetRef="a1" />
    <bpmn:association id="as_a2" sourceRef="T5" targetRef="a2" />
    <bpmn:association id="as_a3" sourceRef="T9" targetRef="a3" />
    <bpmn:association id="as_a4" sourceRef="T13" targetRef="a4" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Vergunning" name="Vergunning aanvragen" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="Lane_A" name="Klantenadviseur">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_S" name="Systeem (KruzeApp)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOk</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Vergunning nodig voor klant">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Vergunningscherm openen en vergunning selecteren">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Dubbelregel van vergunningtype controleren">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Toevoegen toegestaan?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndRef" name="Vergunning bestaat al">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Err_Dubbel" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="T3" name="Vergunningsrecord aanmaken en vooraf invullen">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T4" name="Ontbrekende gegevens aanvullen">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Vooraf ingevulde waarde gewijzigd?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="Kiezen: klantenrecord mee aanpassen of enkel lokaal">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Keuze?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="Klantenrecord bijwerken">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T7" name="Gegevens valideren en bewaren">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G5" name="Verplichte velden volledig?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T8" name="Document laten genereren">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T9" name="Document genereren en aan dossier toevoegen">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T10" name="Document downloaden">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T11" name="Document extern opladen">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G6" name="Bevestiging ontvangen?">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T12" name="Bevestiging toevoegen aan aanvraag (mail, printscreen, document)">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G7" name="">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T13" name="Status op 'aangevraagd' zetten">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T14" name="Statuswijziging loggen (wie, wanneer, documentversie)">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndOk" name="Vergunning aangevraagd">
      <bpmn:incoming>f27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="f3" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="f4" name="Nee, niet toegestaan" sourceRef="G1" targetRef="EndRef" />
    <bpmn:sequenceFlow id="f5" name="Ja" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="f6" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="f7" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="f8" name="Nee" sourceRef="G2" targetRef="G4" />
